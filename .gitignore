# ASCALPI Dev-Work bootstrap policy R1

# Git mailbox is local-only.
/Git/

# Machine / virtual-disk state.
*.vhd
*.vhdx
*.qcow2
*.img
*.iso
*.lnk

# Secrets / credentials.
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
*.kdbx
**/credentials/
**/Credentials/
**/secrets/
**/Secrets/

# IDE and generated caches.
**/.git/
**/.vs/
**/.idea/
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.cache/
**/node_modules/
**/.venv/
**/obj/
*.pyc
*.pyo
*.log
*.tmp
*.temp
*.bak
*.old
*.pid
*.lock
*.db-wal
*.db-shm

# 1-Dev engineering only: runtime/executable payload is not versioned here.
/1-Dev/SM_Repo/Backups/
/1-Dev/SM_Repo/Receipts/
/1-Dev/System/Runtime/
/1-Dev/System/Host/Bin/
/1-Dev/System/CJL.exe
/1-Dev/System/Data/
/1-Dev/System/Shared/
/1-Dev/System/Repo/
/1-Dev/System/Logs/
/1-Dev/System/Temp/
/1-Dev/System/Export/
/1-Dev/System/Backup/
/1-Dev/System/Updates/In/

# Compiler engineering only: local compiler runtime and generated runs stay local.
/2-Compiler/Builds/
/2-Compiler/Compilador/
/2-Compiler/Runtime/
/2-Compiler/Patches/Inbox/
/2-Compiler/Releases/Approved/

# Git_Main local homologation state.
/3-Git_Main/Evidence/
/3-Git_Main/Evidencias/
/3-Git_Main/Receipt/
/3-Git_Main/Receipts/
/3-Git_Main/Rollback/
/3-Git_Main/System/Data/
