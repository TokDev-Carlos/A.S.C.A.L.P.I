{
  "policy_id": "CJL-EVENT-RULES-001",
  "default_action": "LEDGER_ONLY",
  "black_open": [
    "PATCH_REJECTED",
    "VALIDATION_FAIL",
    "BUILD_FAIL",
    "PROMOTION_FAIL",
    "HOMOLOGATION_FAIL",
    "ROLLBACK_FAIL",
    "SECURITY_FAIL",
    "INTEGRITY_FAIL",
    "SYNC_FAIL"
  ],
  "conditional_black_open": {
    "AUTH_FAIL": {
      "cause_class_in": [
        "SYSTEM",
        "CONFIGURATION",
        "INTEGRATION",
        "SECURITY"
      ],
      "excluded_cause_class": [
        "USER_INPUT",
        "EXPECTED_NEGATIVE_TEST"
      ]
    }
  },
  "black_lifecycle": {
    "CORRECTION_RETEST_PASS": {
      "requires_correlation_id": true,
      "action": "CLOSE_ENGINE_MANAGED_BLACK_ENTRY",
      "white_if_reusable_knowledge": true
    }
  },
  "white_create": {
    "PROOF_PASS": {
      "requires_reusable_knowledge": true
    },
    "PROCEDURE_PROVEN": {
      "requires_reusable_knowledge": true
    },
    "RECOVERY_PROVEN": {
      "requires_reusable_knowledge": true
    },
    "HOMOLOGATION_PASS": {
      "requires_reusable_knowledge": true
    }
  },
  "ledger_only_examples": [
    "PATCH_CREATED",
    "PATCH_APPLIED",
    "VALIDATION_PASS",
    "BUILD_PASS",
    "AUTH_PASS",
    "ROLLBACK",
    "PROMOTION_PASS",
    "STARTUP",
    "SHUTDOWN",
    "USER_CANCELLED",
    "EXPECTED_NEGATIVE_TEST"
  ],
  "rules": {
    "ordinary_success_does_not_create_white_book_entry": true,
    "ordinary_user_auth_failure_does_not_create_black_book_entry": true,
    "same_problem_uses_same_correlation_id": true,
    "new_fail_id_allocated_by_scanning_live_book": true,
    "new_wb_id_allocated_by_scanning_live_book": true,
    "state_file_is_not_sufficient_authority_for_next_id": true,
    "unknown_event_type": "LEDGER_ONLY_AND_FLAG_UNCLASSIFIED"
  }
}
